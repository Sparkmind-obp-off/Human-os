    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@eslint/js": "^9.35.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^5.4.20",
    "vitest": "^2.1.9",
    "wrangler": "^4.135.0"
  }
}
