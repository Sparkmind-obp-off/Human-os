{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaevos",
  "compatibility_date": "2026-09-19",
  "pages_build_output_dir": "./dist",
  "vars": {
    "ENVIRONMENT": "production",
    "KAEVOS_VERSION": "0.1.0",
    "LLM_PROVIDER": "mock",
    "CONNECTOR_MODE": "disabled",
    "REQUEST_TIMEOUT_MS": "10000"
  }
}
